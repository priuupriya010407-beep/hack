{
  "name": "proofpixel-ai",
  "private": true,
  "version": "1.0.0",
  "description": "ProofPixel AI — digital authenticity and media forensics platform",
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "test": "vitest run",
    "predev": "node scripts/ensure-dev-secret.js",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "server": "node server/index.js",
    "start": "node server/index.js"
  },
  "keywords": [
    "forensics",
    "authenticity",
    "hackathon",
    "ai",
    "security"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.3.0",
    "image-size": "^2.0.4",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tesseract.js": "^7.0.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
